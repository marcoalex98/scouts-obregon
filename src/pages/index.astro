---
import { Image } from 'astro:assets';
import { ArrowDown, ArrowRight, ArrowUpRight, Backpack, Binoculars, Compass, Flame, HandHeart, HeartHandshake, Map, MapPin, Mountain, Plus, Route, Shield, Sparkles, Star, Tent, TreePine, Users } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MeetingLocation from '../components/MeetingLocation.astro';
import { scoutSections, sectionHref } from '../data/sections';
import { site, meetingSummary } from '../data/site';
import { familyInfo, groupFeeSummary, scoutsMexicoRegistrationSummary } from '../data/families';
import tropaGirl from '../assets/characters/tropa_girl.webp';
import clanBoy from '../assets/characters/clan_boy.webp';
import avatarManada from '../assets/characters/avatar/avatar-manada.webp';
import avatarTropa from '../assets/characters/avatar/avatar-tropa.webp';
import avatarComunidad from '../assets/characters/avatar/avatar-comunidad.webp';
import avatarClan from '../assets/characters/avatar/avatar-clan.webp';
const avatars = { manada: avatarManada, tropa: avatarTropa, comunidad: avatarComunidad, clan: avatarClan };

const minAge = Math.min(...scoutSections.map((section) => section.minAge));
const maxAge = Math.max(...scoutSections.map((section) => section.maxAge));
const meetingGeo = site.meeting.latitude !== undefined && site.meeting.longitude !== undefined
  ? { geo: { '@type': 'GeoCoordinates', latitude: site.meeting.latitude, longitude: site.meeting.longitude } }
  : {};
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.name, alternateName: site.alternateName, inLanguage: 'es-MX', publisher: { '@id': `${site.url}/#organization` } },
    { '@type': 'Organization', '@id': `${site.url}/#organization`, name: site.name, url: site.url, location: { '@type': 'Place', name: site.meeting.place, description: site.meeting.reference, address: { '@type': 'PostalAddress', streetAddress: site.meeting.reference, addressLocality: 'Ciudad Obregón', addressRegion: 'Sonora', addressCountry: 'MX' }, ...meetingGeo, hasMap: site.meeting.mapsUrl } },
    { '@type': 'FAQPage', '@id': `${site.url}/#faq`, mainEntity: [
      { '@type': 'Question', name: '¿Qué sección corresponde a su edad?', acceptedAnswer: { '@type': 'Answer', text: `Las secciones acompañan distintas etapas de crecimiento. ${scoutSections.map((s) => `${s.name}: de ${s.minAge} a ${s.maxAge} años`).join('. ')}.` } },
      { '@type': 'Question', name: '¿Cómo se planea el aprendizaje?', acceptedAnswer: { '@type': 'Answer', text: 'Cada actividad responde al esquema de progresión scout y busca desarrollar objetivos y competencias. La propuesta se relaciona con las 5 P del desarrollo sostenible y con los Objetivos de Desarrollo Sostenible de la ONU.' } },
      { '@type': 'Question', name: '¿Cuáles son los costos para comenzar?', acceptedAnswer: { '@type': 'Answer', text: `${scoutsMexicoRegistrationSummary} ${groupFeeSummary} La camisa del uniforme cuesta aproximadamente $${familyInfo.registration.shirtApproximate} MXN. Los costos de campamentos, excursiones y actividades se informan por evento.` } },
      { '@type': 'Question', name: '¿Qué uniforme necesitan?', acceptedAnswer: { '@type': 'Answer', text: 'Para comenzar pueden asistir con ropa cómoda. Después del registro se solicita al menos la camisa scout, pantalón, short o falda azul marino, calcetas azul marino y calzado cómodo y seguro.' } },
      { '@type': 'Question', name: '¿Con qué frecuencia hay campamentos y salidas?', acceptedAnswer: { '@type': 'Answer', text: 'El grupo procura realizar al menos dos campamentos por semestre y una salida cada mes o bimestre, siempre que las condiciones, especialmente el calor, lo permitan. Las fechas y costos se comunican por actividad.' } },
      { '@type': 'Question', name: '¿También pueden participar personas adultas?', acceptedAnswer: { '@type': 'Answer', text: 'Sí, a través del voluntariado. Es una forma de colaborar con las experiencias formativas del grupo.' } },
      { '@type': 'Question', name: '¿Dónde y cuándo se reúnen?', acceptedAnswer: { '@type': 'Answer', text: `${meetingSummary} En ocasiones especiales las actividades se realizan en la Casa Scout.` } },
    ] },
  ],
};
---

<SiteLayout
  title="Scouts en Ciudad Obregón | Grupo Scout 5 Mak’Chu"
  description="Conoce al Grupo Scout 5 Mak’Chu en Ciudad Obregón. Descubre nuestras secciones de 6 a 21 años y las oportunidades para adultos voluntarios."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  <SiteHeader />
  <main id="contenido">
    <section class="hero" aria-labelledby="hero-title">
      <!-- Flor de lis — esquina superior derecha -->
      <div class="hero-deco hero-deco-right" aria-hidden="true">
        <svg viewBox="0 0 64 80" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M32 3C28 12 19 21 22 31c2 8 7 12 7 18h6c0-6 5-10 7-18C45 21 36 12 32 3Z"/>
          <path d="M26 49c-1-14-9-24-18-20C0 33 2 44 10 47c-4-6-2-11 3-10 5 1 8 7 8 12Z"/>
          <path d="M26 49c-1-14-9-24-18-20C0 33 2 44 10 47c-4-6-2-11 3-10 5 1 8 7 8 12Z" transform="translate(64 0) scale(-1 1)"/>
          <rect x="18" y="49" width="28" height="6" rx="2"/>
          <path d="M28 55c0 7-3 12-8 15 5 2 9 0 12-4 3 4 7 6 12 4-5-3-8-8-8-15Z"/>
          <path d="M28 55h8c-1 9 1 15-4 22-5-7-3-13-4-22Z"/>
        </svg>
      </div>
      <!-- Flor de lis — esquina inferior izquierda -->
      <div class="hero-deco hero-deco-left" aria-hidden="true">
        <svg viewBox="0 0 64 80" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M32 3C28 12 19 21 22 31c2 8 7 12 7 18h6c0-6 5-10 7-18C45 21 36 12 32 3Z"/>
          <path d="M26 49c-1-14-9-24-18-20C0 33 2 44 10 47c-4-6-2-11 3-10 5 1 8 7 8 12Z"/>
          <path d="M26 49c-1-14-9-24-18-20C0 33 2 44 10 47c-4-6-2-11 3-10 5 1 8 7 8 12Z" transform="translate(64 0) scale(-1 1)"/>
          <rect x="18" y="49" width="28" height="6" rx="2"/>
          <path d="M28 55c0 7-3 12-8 15 5 2 9 0 12-4 3 4 7 6 12 4-5-3-8-8-8-15Z"/>
          <path d="M28 55h8c-1 9 1 15-4 22-5-7-3-13-4-22Z"/>
        </svg>
      </div>
      <div class="page-width hero-inner">
        <p class="eyebrow hero-eyebrow justify-center"><span class="hero-dot" aria-hidden="true"></span>Scouts en Ciudad Obregón</p>
        <h1 id="hero-title">La aventura de<br /><span>crecer juntos.</span></h1>
        <p class="hero-description">Amigos, nuevos retos y un mundo por descubrir.<br class="hidden sm:block" /> Encuentra tu lugar en el Grupo Scout 5 Mak’Chu.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a class="button hero-btn-primary" href="/contacto">Quiero unirme <ArrowRight size={17} aria-hidden="true" /></a>
          <a class="button hero-btn-secondary" href="#secciones">Explorar secciones <ArrowDown size={16} aria-hidden="true" /></a>
        </div>
        <!-- Badges de secciones -->
        <div class="hero-chips" aria-label="Secciones del grupo">
          <a class="hero-chip hero-chip--yellow" href="/secciones/manada">
            <Sparkles size={14} aria-hidden="true" />Manada · 6–9 años
          </a>
          <a class="hero-chip hero-chip--green" href="/secciones/tropa">
            <Compass size={14} aria-hidden="true" />Tropa · 10–13 años
          </a>
          <a class="hero-chip hero-chip--blue" href="/secciones/comunidad">
            <Route size={14} aria-hidden="true" />Caminantes · 14–17 años
          </a>
          <a class="hero-chip hero-chip--red" href="/secciones/clan">
            <HandHeart size={14} aria-hidden="true" />Clan · 18–21 años
          </a>
        </div>
        <p class="hero-location"><MapPin size={14} aria-hidden="true" /> Ciudad Obregón, Sonora <span aria-hidden="true">·</span> De {minAge} a {maxAge} años</p>
      </div>
      <!-- Silueta de montañas -->
      <div class="hero-mountains" aria-hidden="true">
        <svg viewBox="0 0 1440 180" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0,180 L0,130 L90,70 L190,110 L320,35 L460,105 L550,60 L670,125 L770,45 L890,115 L1010,55 L1130,120 L1250,65 L1370,105 L1440,80 L1440,180 Z" fill="rgba(125,211,252,.06)"/>
          <path d="M0,180 L0,150 L130,95 L250,138 L370,78 L490,132 L610,92 L730,148 L850,92 L970,138 L1090,98 L1210,142 L1330,102 L1440,128 L1440,180 Z" fill="rgba(255,255,255,.045)"/>
        </svg>
      </div>
      <div class="hero-wave" aria-hidden="true">
        <svg viewBox="0 0 1440 72" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0,36 C320,72 800,0 1440,42 L1440,72 L0,72 Z" fill="var(--surface-page)"/>
        </svg>
      </div>
      <div class="hero-char-left" aria-hidden="true">
        <Image src={tropaGirl} alt="" width={200} height={400} />
      </div>
      <div class="hero-char-right" aria-hidden="true">
        <Image src={clanBoy} alt="" width={200} height={400} />
      </div>
    </section>

    <!-- Ticker de actividades -->
    <div class="activity-strip" aria-hidden="true">
      <div class="activity-track">
        <span class="activity-item"><Tent size={15} />Acampadas</span>
        <span class="activity-item"><Flame size={15} />Fogatas</span>
        <span class="activity-item"><Map size={15} />Exploración</span>
        <span class="activity-item"><Mountain size={15} />Montañismo</span>
        <span class="activity-item"><Star size={15} />Logros</span>
        <span class="activity-item"><Shield size={15} />Valores</span>
        <span class="activity-item"><Backpack size={15} />Aventura</span>
        <span class="activity-item"><Binoculars size={15} />Observación</span>
        <span class="activity-item"><TreePine size={15} />Naturaleza</span>
        <span class="activity-item"><Sparkles size={15} />Creatividad</span>
        <!-- Duplicado para loop infinito -->
        <span class="activity-item"><Tent size={15} />Acampadas</span>
        <span class="activity-item"><Flame size={15} />Fogatas</span>
        <span class="activity-item"><Map size={15} />Exploración</span>
        <span class="activity-item"><Mountain size={15} />Montañismo</span>
        <span class="activity-item"><Star size={15} />Logros</span>
        <span class="activity-item"><Shield size={15} />Valores</span>
        <span class="activity-item"><Backpack size={15} />Aventura</span>
        <span class="activity-item"><Binoculars size={15} />Observación</span>
        <span class="activity-item"><TreePine size={15} />Naturaleza</span>
        <span class="activity-item"><Sparkles size={15} />Creatividad</span>
      </div>
    </div>

    <section id="secciones" class="page-width section-spacing" aria-labelledby="sections-title">
      <div class="section-intro">
        <div>
          <p class="eyebrow">Nuestras secciones</p>
          <h2 id="sections-title" class="section-title mt-4">Una aventura para<br class="hidden sm:block" /> cada etapa.</h2>
        </div>
        <p class="max-w-sm text-sm leading-[1.9] text-muted">Desde los primeros descubrimientos hasta los proyectos que dejan huella. Encuentra la sección que va contigo.</p>
      </div>
      <div class="mt-10 sections-strip">
        {scoutSections.map((section) => (
          <a href={sectionHref(section)} class="sec-card" data-theme={section.color}>
            <div class="sec-card-avatar">
              <Image src={avatars[section.slug]} alt="" width={96} height={96} />
            </div>
            <div class="sec-card-body">
              <span class="sec-card-age">{section.minAge}–{section.maxAge} años</span>
              <strong class="sec-card-name">{section.name}</strong>
              <p class="sec-card-line">{section.headline}</p>
            </div>
            <span class="sec-card-arrow" aria-hidden="true"><ArrowRight size={18} /></span>
          </a>
        ))}
      </div>
      <a class="text-link mt-6" href="/secciones">Explorar todas las secciones <ArrowRight size={16} aria-hidden="true" /></a>
    </section>

    <section id="el-grupo" class="group-section" aria-labelledby="group-title">
      <div class="page-width py-16 sm:py-20">
        <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
          <div>
            <p class="eyebrow">Somos Mak’Chu</p>
            <h2 id="group-title" class="section-title mt-4">Lo que vivimos<br /> nos hace crecer.</h2>
            <p class="mt-5 max-w-md text-sm leading-[1.9] text-body">Somos el Grupo Scout 5 Mak’Chu, de Ciudad Obregón, Provincia Sonora. Creemos en aprender haciendo y en crecer junto a otras personas.</p>
            <p class="group-years mt-4"><span>+25</span> años en Ciudad Obregón</p>
          </div>
          <div class="grid gap-7 sm:grid-cols-3 lg:gap-6 lg:pt-3">
            <div><span class="value-icon vi-orange" aria-hidden="true"><Users size={26} stroke-width={1.6} /></span><h3 class="mt-4 text-sm font-extrabold">Amistad</h3><p class="mt-2 text-[13px] leading-[1.85] text-body">Un equipo con el que compartir, colaborar y ser tú mismo.</p></div>
            <div><span class="value-icon vi-sky" aria-hidden="true"><Compass size={26} stroke-width={1.6} /></span><h3 class="mt-4 text-sm font-extrabold">Descubrimiento</h3><p class="mt-2 text-[13px] leading-[1.85] text-body">Nuevos retos para conocer tus habilidades y seguir aprendiendo.</p></div>
            <div><span class="value-icon vi-navy" aria-hidden="true"><HeartHandshake size={26} stroke-width={1.6} /></span><h3 class="mt-4 text-sm font-extrabold">Servicio</h3><p class="mt-2 text-[13px] leading-[1.85] text-body">El compromiso de aportar algo bueno a nuestra comunidad.</p></div>
          </div>
        </div>
      </div>
    </section>

    <section id="familias" class="page-width section-spacing" aria-labelledby="families-title">
      <div class="families-heading">
        <div>
          <p class="eyebrow">Para familias</p>
          <h2 id="families-title" class="section-title mt-4">Todo lo necesario<br /> para comenzar.</h2>
        </div>
        <div class="families-intro">
          <p class="mt-5 max-w-sm text-sm leading-[1.9] text-muted">Conoce cómo se planean las actividades, qué incluye el registro y qué necesitan niñas, niños y jóvenes en sus primeras sesiones.</p>
          <div class="families-actions">
            <a class="text-link" href={familyInfo.scoutsMexicoUrl} target="_blank" rel="noopener noreferrer">Conocer Scouts de México <span class="sr-only">(abre otra pestaña)</span></a>
            <a class="text-link" href="/contacto">Quiero más información <ArrowUpRight size={16} aria-hidden="true" /></a>
          </div>
        </div>
      </div>
      <div class="faq-list families-faq">
          <details open>
            <summary><span>¿Qué sección corresponde a su edad?</span><Plus size={17} class="faq-plus" aria-hidden="true" /></summary>
            <div class="faq-answer">
              <p>Las secciones acompañan distintas etapas de crecimiento:</p>
              <div class="mt-3 space-y-2">
                {scoutSections.map((section) => (
                  <p><a class="underline decoration-outline-strong underline-offset-4 hover:text-primary-ink" href={sectionHref(section)}>{section.name}: {section.minAge} a {section.maxAge} años.</a></p>
                ))}
              </div>
            </div>
          </details>
          <details>
            <summary><span>¿Cómo se planea el aprendizaje?</span><Plus size={17} class="faq-plus" aria-hidden="true" /></summary>
            <div class="faq-answer space-y-3">
              <p>Cada actividad responde al esquema de progresión scout y busca desarrollar objetivos y competencias. En Manada, por ejemplo, las sesiones se conocen como <em>cacerías</em>.</p>
              <p>Una visita al Museo de Cócorit puede trabajar la relación con el entorno: reconocer el valor de la herencia cultural y respetar culturas diferentes de la propia.</p>
              <p>Nuestras actividades se relacionan con las 5 P —Personas, Planeta, Prosperidad, Paz y Alianzas— y están apegadas a los <a class="underline underline-offset-4" href={familyInfo.sustainableDevelopmentGoalsUrl} target="_blank" rel="noopener noreferrer">Objetivos de Desarrollo Sostenible de la ONU<span class="sr-only"> (abre otra pestaña)</span></a>.</p>
            </div>
          </details>
          <details>
            <summary><span>¿Cuáles son los costos para comenzar?</span><Plus size={17} class="faq-plus" aria-hidden="true" /></summary>
            <div class="faq-answer space-y-3">
              <p><strong>Registro anual a Scouts de México: ${familyInfo.registration.scoutsMexicoAnnual.toLocaleString('es-MX')} MXN por participante.</strong> Incluye seguro scout durante las actividades, credencial, parche anual, agenda y los materiales que determine la asociación.</p>
              <p><strong>Cuota anual del grupo: ${familyInfo.registration.groupAnnualPerFamily.toLocaleString('es-MX')} MXN por familia.</strong> Apoya la entrega de pañoleta, insignias de progresión y otros reconocimientos scouts.</p>
              <p><strong>Campamentos, excursiones y actividades:</strong> el costo se informa por evento. Las familias suelen organizar actividades para apoyarse con estos gastos.</p>
              <p class="family-note mt-4">Montos comunicados en {familyInfo.updatedAt}. Confírmalos con el grupo antes de realizar cualquier pago.</p>
            </div>
          </details>
          <details>
            <summary><span>¿Qué uniforme necesitan?</span><Plus size={17} class="faq-plus" aria-hidden="true" /></summary>
            <div class="faq-answer space-y-3">
              <p>Para comenzar solo necesitan ropa cómoda. Después del registro se solicita al menos la camisa scout, con un costo aproximado de ${familyInfo.registration.shirtApproximate.toLocaleString('es-MX')} MXN.</p>
              <p>El pantalón, short o falda puede ser el que prefieran, en color azul marino y tela cómoda y resistente. También se piden calcetas azul marino y calzado seguro para realizar actividades.</p>
            </div>
          </details>
          <details>
            <summary><span>¿Con qué frecuencia hay campamentos y salidas?</span><Plus size={17} class="faq-plus" aria-hidden="true" /></summary>
            <div class="faq-answer"><p>El grupo procura realizar al menos dos campamentos por semestre y una excursión o salida cada mes o bimestre. Las fechas dependen de la organización de cada actividad y, especialmente, de las condiciones de calor.</p></div>
          </details>
          <details>
            <summary><span>¿Dónde y cuándo se reúnen?</span><Plus size={17} class="faq-plus" aria-hidden="true" /></summary>
            <div class="faq-answer space-y-3">
              <p>{meetingSummary} <a class="underline underline-offset-4" href="#ubicacion">Ver la ubicación habitual.</a></p>
              <p>En ocasiones especiales nos reunimos en la <a class="underline underline-offset-4" href={familyInfo.specialVenue.mapsUrl} target="_blank" rel="noopener noreferrer">Casa Scout<span class="sr-only"> (abre Google Maps en otra pestaña)</span></a>. Cada cambio se comunica previamente a las familias.</p>
            </div>
          </details>
          <details>
            <summary><span>¿También pueden participar personas adultas?</span><Plus size={17} class="faq-plus" aria-hidden="true" /></summary>
            <div class="faq-answer"><p>Sí, a través del voluntariado. Es una forma de colaborar con las experiencias formativas del grupo. <a class="underline underline-offset-4" href="#voluntariado">Conoce el apartado de Adultos voluntarios.</a></p></div>
          </details>
      </div>
    </section>

    <section id="voluntariado" class="page-width pb-20 sm:pb-24" aria-labelledby="volunteers-title">
      <div class="volunteer-panel">
        <div class="max-w-xl">
          <p class="eyebrow">Adultos voluntarios</p>
          <h2 id="volunteers-title" class="section-title mt-4">Tu experiencia también<br class="hidden sm:block" /> puede dejar huella.</h2>
          <p class="mt-5 max-w-lg text-sm leading-[1.9] text-body">Comparte tu tiempo y tus habilidades para acompañar a las nuevas generaciones. El voluntariado sostiene las experiencias que hacen crecer al grupo.</p>
        </div>
        <div class="shrink-0">
          <a class="button button-primary" href="/voluntariado">Quiero ser voluntario <ArrowUpRight size={16} aria-hidden="true" /></a>
          <p class="mt-3 text-xs text-muted">Hay más de una forma de ser parte.</p>
        </div>
      </div>
    </section>

    <MeetingLocation />
    <section id="unete" class="join-section" aria-labelledby="join-title">
      <div class="page-width py-16 text-center sm:py-20">
        <p class="eyebrow justify-center">Únete a Mak’Chu</p>
        <h2 id="join-title" class="section-title mt-4">El siguiente paso<br /> empieza contigo.</h2>
        <p class="mx-auto mt-5 max-w-lg text-sm leading-[1.9] text-body">Ya sea para vivir tu primera aventura scout o para compartir tu experiencia como voluntario, nos gustaría conocerte.</p>
        <a class="button button-primary mt-7" href="/contacto">Escribirnos <ArrowUpRight size={16} aria-hidden="true" /></a>
      </div>
    </section>
  </main>
  <SiteFooter />
</SiteLayout>

<style>
  .hero { position: relative; display: flex; align-items: center; min-height: calc(100vh - var(--site-header-height)); min-height: calc(100dvh - var(--site-header-height)); padding: clamp(2rem, 6vh, 5rem) 0 0; text-align: center; overflow: hidden; background-color: #0C2D5A; background-image: linear-gradient(150deg, #0A2342 0%, #0C2D5A 55%, #0D3870 100%), radial-gradient(rgba(125,211,252,.13) 1px, transparent 1px); background-size: cover, 28px 28px; }
  .hero-deco { position: absolute; aspect-ratio: 64/80; pointer-events: none; user-select: none; }
  .hero-deco svg { width: 100%; height: 100%; }
  .hero-deco-right { right: -5%; top: -8%; width: min(50vw, 440px); color: rgba(255,255,255,.045); transform: rotate(12deg); }
  .hero-deco-left { left: -4%; bottom: 8%; width: min(30vw, 260px); color: rgba(249,115,22,.06); transform: rotate(-18deg); }
  .hero-inner { position: relative; z-index: 1; padding-bottom: 5rem; }
  .hero-eyebrow { color: #7DD3FC; }
  .hero-dot { display: inline-block; width: .45rem; height: .45rem; border-radius: 99px; background: #F97316; }
  .hero h1 { margin: 1.5rem auto 1.4rem; font-size: clamp(3rem, 7.4vw, 6.7rem); line-height: 1.07; font-weight: 800; letter-spacing: -.03em; color: #fff; }
  .hero h1 span { color: #F97316; }
  .hero-description { max-width: 36rem; margin-inline: auto; font-size: clamp(.94rem, 1.6vw, 1.12rem); line-height: 1.9; color: #BAE6FD; }
  .hero-btn-primary { background: #F97316; color: #fff; border-color: transparent; border-radius: 99px; }
  .hero-btn-primary:hover { background: #EA580C; }
  .hero-btn-secondary { border-radius: 99px; border-color: rgba(255,255,255,.28); background: rgba(255,255,255,.08); color: #fff; }
  .hero-btn-secondary:hover { background: rgba(255,255,255,.15); border-color: rgba(255,255,255,.45); }
  .hero-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: .55rem; margin-top: 2rem; }
