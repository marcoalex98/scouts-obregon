---
import { ArrowLeft, Compass, HandHeart, Route, Sparkles } from '@lucide/astro';
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { scoutSections } from '../data/sections';
import { site } from '../data/site';
import '../styles/sections.css';
import avatarManada from '../assets/characters/avatar/avatar-manada.webp';
import avatarTropa from '../assets/characters/avatar/avatar-tropa.webp';
import avatarComunidad from '../assets/characters/avatar/avatar-comunidad.webp';
import avatarClan from '../assets/characters/avatar/avatar-clan.webp';
const avatars = { manada: avatarManada, tropa: avatarTropa, comunidad: avatarComunidad, clan: avatarClan };

// Build WhatsApp URLs
function waUrl(number: string | null, message: string) {
  if (!number) return null;
  return `https://wa.me/${number.replace(/\D/g, '')}?text=${encodeURIComponent(message)}`;
}

const sectionLinks = scoutSections.map((s) => ({
  ...s,
  waHref: waUrl(
    s.whatsapp.number,
    `Hola ${s.whatsapp.contact}, me comunico desde el sitio web del Grupo Scout 5 Mak'Chu. Estoy interesado/a en inscribir a un joven en la *${s.name}* (${s.minAge}–${s.maxAge} años). ¿Me podrías orientar sobre el proceso de inscripción y los próximos pasos?`
  ),
}));

const volunteerHref = waUrl(
  site.volunteerWhatsapp.number,
  `Hola ${site.volunteerWhatsapp.contact}, me comunico desde el sitio web del Grupo Scout 5 Mak'Chu. Estoy interesado/a en unirme como adulto voluntario al grupo. ¿Me podrías dar más información sobre los roles disponibles y cómo participar?`
);
---

<SiteLayout
  title="Contacto | Grupo Scout 5 Mak'Chu · Ciudad Obregón"
  description="Inscribe a un niño, niña, adolescente o joven en el Grupo Scout 5 Mak'Chu, o únete como adulto voluntario. Ciudad Obregón, Sonora."
>
  <SiteHeader />
  <main id="contenido">

    <div class="page-width"><Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Contacto', href: '/contacto' }]} /></div>
    <div class="page-width contact-wrap">

      <!-- STEP 1: Dos opciones -->
      <div id="step-1" class="step">
        <div class="step-header">
          <h1 class="step-title">¿Cómo te podemos ayudar?</h1>
          <p class="step-desc">Elige una opción para ponerte en contacto con la persona indicada.</p>
        </div>
        <div class="options-grid">
          <button class="option-card option-card--youth" data-action="go-youth" type="button">
            <span class="option-icon option-icon--yellow" aria-hidden="true"><Sparkles size={32} /></span>
            <strong>Inscribir a un joven</strong>
            <p>Niñas, niños, adolescentes y jóvenes de 6 a 21 años</p>
            <span class="option-arrow" aria-hidden="true">→</span>
          </button>
          <button class="option-card option-card--volunteer" data-action="go-volunteer" type="button">
            <span class="option-icon option-icon--orange" aria-hidden="true"><HandHeart size={32} /></span>
            <strong>Ser adulto voluntario</strong>
            <p>A partir de 22 años — scouters, dirigentes y más</p>
            <span class="option-arrow" aria-hidden="true">→</span>
          </button>
        </div>
        <div class="social-links">
          <a class="ig-link" href="https://www.instagram.com/scoutsobregon/" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="18" height="18"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
            @scoutsobregon
          </a>
          <a class="ig-link ig-link--fb" href="https://www.facebook.com/ScoutsObregon" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="18" height="18"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.267h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>
            ScoutsObregon
          </a>
        </div>
      </div>

      <!-- STEP 2a: Secciones -->
      <div id="step-youth" class="step" hidden>
        <button class="back-btn" data-action="back" type="button">
          <ArrowLeft size={16} aria-hidden="true" /> Regresar
        </button>
        <div class="step-header">
          <h2 class="step-title">¿A qué sección pertenece?</h2>
          <p class="step-desc">Cada sección tiene su propio responsable. Elige la que corresponde a la edad del joven.</p>
        </div>
        <div class="sections-grid">
          {sectionLinks.map((s) => (
            <div class="section-contact-card" data-theme={s.color}>
              <div class="scc-header">
                <Image src={avatars[s.slug]} alt="" width={56} height={56} class="scc-avatar" />
                <span class="scc-age">{s.minAge}–{s.maxAge} años</span>
              </div>
              <strong class="scc-name">{s.name}</strong>
              <p class="scc-headline">{s.headline}</p>
              {s.waHref ? (
                <a class="wa-btn" href={s.waHref} target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="18" height="18"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.123 1.532 5.855L0 24l6.302-1.517A11.94 11.94 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.794 9.794 0 0 1-5.003-1.374l-.358-.214-3.742.9.937-3.63-.234-.373A9.76 9.76 0 0 1 2.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/></svg> WhatsApp
                </a>
              ) : (
                <span class="wa-pending">Contacto próximamente</span>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- STEP 2b: Voluntariado -->
      <div id="step-volunteer" class="step" hidden>
        <button class="back-btn" data-action="back" type="button">
          <ArrowLeft size={16} aria-hidden="true" /> Regresar
        </button>
        <div class="step-header">
          <h2 class="step-title">Voluntariado adulto</h2>
          <p class="step-desc">Escríbenos para conocer los roles disponibles y cómo sumarte al equipo. Debes tener 22 años o más.</p>
        </div>
        <div class="volunteer-contact-block">
          <div class="vcb-info">
            <span class="option-icon option-icon--orange" aria-hidden="true"><HandHeart size={28} /></span>
            <div>
              <strong>Coordinación de voluntariado</strong>
              <p>Te explicamos los roles, el compromiso y los próximos pasos para unirte al grupo.</p>
            </div>
          </div>
          {volunteerHref ? (
            <a class="wa-btn wa-btn--large" href={volunteerHref} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="20" height="20"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.123 1.532 5.855L0 24l6.302-1.517A11.94 11.94 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.794 9.794 0 0 1-5.003-1.374l-.358-.214-3.742.9.937-3.63-.234-.373A9.76 9.76 0 0 1 2.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/></svg> Escribir por WhatsApp
            </a>
          ) : (
            <span class="wa-pending">Contacto próximamente</span>
          )}
          <p class="vcb-alt">También puedes conocer todos los detalles en la <a href="/voluntariado">página de voluntariado</a>.</p>
        </div>
      </div>

    </div>
  </main>
  <SiteFooter />
</SiteLayout>

<script>
  function show(id: string) {
    document.querySelectorAll('.step').forEach((el) => { (el as HTMLElement).hidden = true; });
    const el = document.getElementById(id);
    if (el) el.hidden = false;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-action]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const action = btn.dataset.action;
      if (action === 'go-youth') show('step-youth');
      else if (action === 'go-volunteer') show('step-volunteer');
      else if (action === 'back') show('step-1');
    });
  });
</script>

<style>
  .contact-wrap { padding-block: 0 3rem; max-width: 56rem; min-height: calc(100dvh - var(--site-header-height) - 6rem); }

  .step-header { margin-bottom: 2.5rem; }
  .step-title { font-size: clamp(1.9rem, 3.5vw, 2.8rem); font-weight: 800; letter-spacing: -.04em; color: var(--content-heading); line-height: 1.15; }
  .step-desc { margin-top: .75rem; font-size: .95rem; color: var(--content-muted); line-height: 1.7; }

  /* Step 1 — opciones */
  .options-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .option-card { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: .9rem; padding: 2.2rem; border: 2.5px solid var(--border-default); border-radius: 1.75rem; background: var(--surface-raised); cursor: pointer; text-align: left; transition: transform .2s, box-shadow .2s, border-color .2s; }
  .option-card strong { font-size: 1.3rem; font-weight: 800; letter-spacing: -.03em; color: var(--content-heading); }
  .option-card p { font-size: .88rem; line-height: 1.7; color: var(--content-muted); }
  .option-card:hover { transform: translateY(-4px); }
  .option-card--youth:hover { border-color: #FCD34D; box-shadow: 0 8px 28px rgba(245,158,11,.18); }
  .option-card--volunteer:hover { border-color: #FDBA74; box-shadow: 0 8px 28px rgba(249,115,22,.18); }
  .option-arrow { font-size: 1.5rem; color: var(--content-muted); transition: transform .2s; margin-top: auto; }
  .option-card:hover .option-arrow { transform: translateX(5px); color: var(--theme-primary); }
  .option-icon { display: inline-grid; place-items: center; width: 4rem; height: 4rem; border-radius: 1.1rem; }
  .option-icon--yellow { background: color-mix(in oklab, #F59E0B 15%, var(--surface-page)); color: light-dark(#92400E, #FCD34D); }
  .option-icon--orange { background: color-mix(in oklab, #F97316 15%, var(--surface-page)); color: light-dark(#9A3412, #FDBA74); }

  /* Back button */
  .back-btn { display: inline-flex; align-items: center; gap: .5rem; margin-bottom: 2rem; padding: .5rem .9rem; border: 1.5px solid var(--border-default); border-radius: 99px; background: none; cursor: pointer; font-size: .82rem; font-weight: 700; color: var(--content-muted); transition: color .15s, border-color .15s; }
  .back-btn:hover { color: var(--theme-primary-ink); border-color: var(--theme-primary-border); }

  /* Sections grid */
  .sections-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .section-contact-card { display: flex; flex-direction: column; gap: .6rem; padding: 1.8rem; border: 2.5px solid var(--theme-primary-border); border-radius: 1.5rem; background: var(--theme-primary-soft); position: relative; overflow: hidden; }
  .section-contact-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 5px; background: var(--theme-primary); }
  .scc-header { display: flex; align-items: center; justify-content: space-between; }
  .scc-avatar { width: 3.5rem; height: 3.5rem; border-radius: 50%; object-fit: cover; border: 2px solid var(--theme-primary-border); background: var(--surface-raised); }
  .scc-age { padding: .3rem .75rem; border: 1.5px solid var(--theme-primary-border); border-radius: 99px; font-size: .72rem; font-weight: 800; color: var(--theme-primary-ink); background: var(--surface-raised); }
  .scc-name { font-size: 1.1rem; font-weight: 800; letter-spacing: -.03em; color: var(--theme-primary-ink); margin-top: .2rem; }
  .scc-headline { font-size: .82rem; color: var(--content-body); line-height: 1.6; flex-grow: 1; }

  /* WhatsApp button */
  .wa-btn { display: inline-flex; align-items: center; gap: .55rem; align-self: flex-start; margin-top: .4rem; padding: .65rem 1.2rem; border-radius: 99px; background: var(--theme-primary); color: var(--theme-on-primary); font-size: .84rem; font-weight: 800; text-decoration: none; transition: background .15s, transform .15s, box-shadow .15s; box-shadow: 0 2px 8px color-mix(in srgb, var(--theme-primary) 30%, transparent); }
  .wa-btn:hover { background: color-mix(in oklab, var(--theme-primary) 85%, #000); transform: translateY(-1px); box-shadow: 0 4px 14px color-mix(in srgb, var(--theme-primary) 35%, transparent); }
  .wa-btn--large { padding: .85rem 1.6rem; font-size: .95rem; }
  .wa-pending { margin-top: .4rem; font-size: .78rem; font-weight: 700; color: var(--content-muted); font-style: italic; }

  /* Volunteer block */
  .volunteer-contact-block { display: flex; flex-direction: column; gap: 1.5rem; padding: 2.4rem; border: 2.5px solid var(--theme-primary-border); border-radius: 1.75rem; background: var(--theme-primary-soft); max-width: 36rem; }
  .vcb-info { display: flex; align-items: start; gap: 1.2rem; }
  .vcb-info strong { display: block; font-size: 1.05rem; font-weight: 800; color: var(--content-heading); }
  .vcb-info p { margin-top: .4rem; font-size: .88rem; line-height: 1.7; color: var(--content-body); }
  .vcb-alt { font-size: .8rem; color: var(--content-muted); }
  .vcb-alt a { color: var(--theme-primary-ink); text-decoration: underline; text-underline-offset: .2rem; }

  .social-links { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; }
  .ig-link { display: inline-flex; align-items: center; gap: .55rem; padding: .6rem 1.1rem; border: 1.5px solid var(--border-default); border-radius: 99px; font-size: .82rem; font-weight: 700; color: var(--content-muted); text-decoration: none; transition: color .15s, border-color .15s; }
  .ig-link:hover { color: var(--theme-primary-ink); border-color: var(--theme-primary-border); }

  @media (max-width: 640px) {
    .options-grid, .sections-grid { grid-template-columns: 1fr; }
    .option-card { padding: 1.6rem; }
  }
</style>
