---
import { Image } from 'astro:assets';
import { ArrowRight, Check } from '@lucide/astro';
import { sectionHref, type ScoutSection } from '../data/sections';
import type { ImageMetadata } from 'astro';

interface Props { section: ScoutSection; compact?: boolean; avatar?: ImageMetadata }
const { section, compact = false, avatar } = Astro.props;
---

<article id={section.slug} data-theme={section.color} class:list={['section-card', { 'section-card-compact': compact }]} aria-labelledby={`${section.slug}-title`}>
  <div class="card-top">
    {avatar
      ? <div class="card-avatar" aria-hidden="true"><Image src={avatar} alt="" width={72} height={72} /></div>
      : <div class="card-avatar-placeholder" aria-hidden="true"></div>
    }
    <span class="age-label">{section.minAge} a {section.maxAge} años</span>
  </div>
  <h3 id={`${section.slug}-title`} class="mt-4 text-2xl font-extrabold tracking-[-0.045em] text-heading sm:text-[1.7rem]">{section.name}</h3>
  <p class="mt-2 text-sm font-semibold text-primary-ink">{section.headline}</p>
  {!compact && <><p class="section-summary mt-5 text-sm leading-[1.85] text-body">{section.summary}</p>
  <ul class="mt-5 grid gap-2.5" aria-label={`Lo que se desarrolla en ${section.name}`}>
    {section.skills.map((skill) => (
      <li class="flex items-center gap-2.5 text-[13px] font-medium text-strong"><Check size={15} class="shrink-0 text-primary-ink" aria-hidden="true" />{skill}</li>
    ))}
  </ul></>}
  <div class="mt-7 border-t border-primary-border pt-3">
    <a class="text-link" href={sectionHref(section)} aria-label={`Conocer ${section.name}`}>
      Conocer {section.shortName} <ArrowRight size={16} aria-hidden="true" />
    </a>
  </div>
</article>

<style>
  .section-card { position: relative; display: flex; flex-direction: column; padding: 1.5rem 2rem 1.5rem; border: 2.5px solid var(--theme-primary-border); border-radius: 1.5rem; background: var(--theme-primary-soft); transition: transform .2s ease, box-shadow .2s ease; }
  .section-card:hover { transform: translateY(-5px); box-shadow: 0 1rem 2.25rem color-mix(in srgb, var(--theme-primary) 16%, transparent); }
  .card-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .card-avatar { width: 4rem; height: 4rem; border-radius: 50%; overflow: hidden; border: 2.5px solid var(--theme-primary-border); flex-shrink: 0; }
  .card-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .card-avatar-placeholder { width: 4rem; height: 4rem; border-radius: 50%; background: var(--theme-primary); flex-shrink: 0; }
  .age-label { padding: .4rem .8rem; border: 1.5px solid var(--theme-primary-border); border-radius: 999px; background: var(--surface-raised); color: var(--theme-primary-ink); font-size: .7rem; font-weight: 750; white-space: nowrap; }
  .section-summary { flex-grow: 1; }
  .section-card-compact { padding: 1.2rem 1.5rem 1.1rem; }
  .section-card-compact .card-avatar { width: 3rem; height: 3rem; }
  .section-card-compact h3 { font-size: 1.25rem; }
  .section-card-compact > p { flex-grow: 1; }
  @media (prefers-reduced-motion: reduce) { .section-card { transition: none; } .section-card:hover { transform: none; } }
  @media (max-width: 640px) { .section-card { padding: 1.2rem 1.4rem 1.1rem; } }
</style>
