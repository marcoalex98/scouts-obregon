---
import { ArrowRight } from '@lucide/astro';
import { site } from '../data/site';
interface Props { name?: string }
const { name } = Astro.props;
---
<section id="informacion" class="section-contact" aria-labelledby="contact-title">
  <div class="page-width py-16 sm:py-20">
    <p class="eyebrow">Tu siguiente paso</p>
    <h2 id="contact-title" class="content-title mt-4">{name ? `¿Te gustaría conocer ${name}?` : 'Encuentra tu lugar en Mak’Chu.'}</h2>
    <p class="section-copy mt-5 max-w-xl">Conocer la sección es el comienzo. Antes de incorporarte, consulta con el grupo el proceso de ingreso y los requisitos vigentes.</p>
    <a class="button button-primary mt-6" href={site.contact?.href ?? '/#unete'}>Solicitar información <ArrowRight size={16} aria-hidden="true" /></a>
    {!site.contact && <p class="mt-3 max-w-lg text-xs leading-relaxed text-body">El canal institucional está pendiente de confirmación. El enlace lleva al aviso de contacto; esta vista previa no recibe solicitudes.</p>}
  </div>
</section>
