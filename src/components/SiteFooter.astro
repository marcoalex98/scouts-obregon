---
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="page-width footer-main">
    <div>
      <a class="footer-logo" href="/">{site.shortName}</a>
      <p class="footer-tagline">Grupo Scout 5 · Ciudad Obregón, Sonora</p>
    </div>
    <div class="footer-right">
      <nav class="footer-nav" aria-label="Navegación del pie de página">
        <a href="/secciones">Secciones</a>
        <a href="/#familias">Para familias</a>
        <a href="/voluntariado">Adultos voluntarios</a>
        <a href="/contacto">Contacto</a>
      </nav>
      <div class="footer-social">
        <a href="https://www.instagram.com/scoutsobregon/" target="_blank" rel="noopener noreferrer" class="footer-social-link">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="16" height="16"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
          Instagram
        </a>
        <a href="https://www.facebook.com/ScoutsObregon" target="_blank" rel="noopener noreferrer" class="footer-social-link">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="16" height="16"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.267h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>
          Facebook
        </a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="page-width footer-bottom-row">
      <span>{site.name}</span>
      <a href="#contenido">Volver al inicio ↑</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 4px solid #F97316; background: #071E3D; color: #BAE6FD; }
  .footer-main { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding-block: 2.75rem; }
  .footer-logo { display: inline-flex; color: #fff; font-size: 1.65rem; font-weight: 900; letter-spacing: -.06em; text-decoration: none; }
  .footer-logo:hover { color: #38BDF8; }
  .footer-tagline { margin-top: .45rem; color: #7DD3FC; font-size: .75rem; }
  .footer-nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .5rem 1.5rem; font-size: .78rem; font-weight: 800; }
  .footer-nav a { min-height: 2.75rem; display: inline-flex; align-items: center; color: #E0F2FE; text-decoration: none; }
  .footer-right { display: flex; flex-direction: column; align-items: flex-end; gap: .75rem; }
  .footer-nav a:hover { color: #F97316; }
  .footer-social { display: flex; gap: 1.25rem; }
  .footer-social-link { display: inline-flex; align-items: center; gap: .4rem; color: #7DD3FC; font-size: .75rem; font-weight: 700; text-decoration: none; }
  .footer-social-link:hover { color: #F97316; }
  .footer-bottom { border-top: 1px solid rgba(125,211,252,.18); background: rgba(0,0,0,.12); }
  .footer-bottom-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .75rem 1.5rem; padding-block: 1.15rem; color: #7DD3FC; font-size: .68rem; }
  .footer-bottom a { color: inherit; text-underline-offset: .25rem; }
  .footer-bottom a:hover { color: #fff; text-decoration: underline; }
  @media (max-width: 640px) {
    .footer-main { align-items: flex-start; flex-direction: column; }
    .footer-right { align-items: flex-start; }
    .footer-nav { justify-content: flex-start; }
  }
</style>
