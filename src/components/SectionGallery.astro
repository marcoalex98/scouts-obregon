---
import type { GalleryPhoto } from '../data/gallery';
import GalleryGrid from './GalleryGrid.astro';

interface Props {
  name: string;
  photos: GalleryPhoto[];
}

const { name, photos } = Astro.props;
---

<section id="galeria" class="detail-block" aria-labelledby="gallery-title">
  <div class="detail-heading">
    <div>
      <p class="eyebrow">Galería de {name}</p>
      <h2 id="gallery-title" class="content-title mt-3">Las aventuras también<br /> se guardan en recuerdos.</h2>
    </div>
    <div class="max-w-sm">
      <p class="section-copy">Fotografías reales relacionadas con esta sección y autorizadas para su publicación.</p>
    </div>
  </div>
  <GalleryGrid
    photos={photos}
    dialogId={`gallery-${name.toLowerCase()}`}
    emptyTitle={`Aquí irán los momentos de ${name}.`}
    emptyText="Aún no hay fotografías autorizadas de esta sección. Este espacio se actualizará cuando el grupo seleccione imágenes que puedan publicarse."
  />
</section>
